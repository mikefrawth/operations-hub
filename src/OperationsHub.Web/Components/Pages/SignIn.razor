@page "/sign-in"
@attribute [AllowAnonymous]

<PageTitle>Sign in</PageTitle>

<div class="py-5 col-md-7 col-lg-5">
    <p class="text-uppercase text-primary fw-semibold mb-2">OperationsHub</p>
    <h1>Sign in</h1>
    <p class="text-body-secondary">Use an authorized OperationsHub account to access administration features.</p>

    @if (Error == "invalid")
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <form method="post" action="/sign-in">
        <AntiforgeryToken />
        <input name="returnUrl" type="hidden" value="@ReturnUrl" />
        <div class="mb-3">
            <label class="form-label" for="email">Email address</label>
            <input id="email" class="form-control" name="email" type="email" autocomplete="username" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input id="password" class="form-control" name="password" type="password" autocomplete="current-password" required />
        </div>
        <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private const string errorMessage = "The email address or password is not valid.";
}
