@page "/sign-in"
@attribute [AllowAnonymous]
@inject Microsoft.AspNetCore.Identity.SignInManager<OperationsHub.Infrastructure.Identity.ApplicationUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<div class="py-5 col-md-7 col-lg-5">
    <p class="text-uppercase text-primary fw-semibold mb-2">OperationsHub</p>
    <h1>Sign in</h1>
    <p class="text-body-secondary">Use an authorized OperationsHub account to access administration features.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="input" OnValidSubmit="SignInAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label" for="email">Email address</label>
            <InputText id="email" class="form-control" @bind-Value="input.Email" autocomplete="username" />
            <ValidationMessage For="() => input.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" class="form-control" type="password" @bind-Value="input.Password" autocomplete="current-password" />
            <ValidationMessage For="() => input.Password" />
        </div>
        <button class="btn btn-primary" type="submit">Sign in</button>
    </EditForm>
</div>

@code {
    private readonly SignInInput input = new();
    private string? errorMessage;

    private async Task SignInAsync()
    {
        errorMessage = null;
        var result = await SignInManager.PasswordSignInAsync(input.Email!, input.Password!, false, lockoutOnFailure: true);
        if (!result.Succeeded)
        {
            errorMessage = "The email address or password is not valid.";
            return;
        }

        Navigation.NavigateTo("/administration/reference-data", forceLoad: true);
    }

    private sealed class SignInInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? Password { get; set; }
    }
}
