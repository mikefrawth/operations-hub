@page "/requests/open-summary"
@attribute [Authorize(Roles = "Manager,Administrator")]
@inject IServiceRequestWorkflowService RequestService
@inject IUserDisplayDirectory UserDirectory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Open request summary</PageTitle>

<div class="py-4">
    <p class="text-uppercase text-primary fw-semibold mb-2">Operations reporting</p>
    <h1>Open request summary</h1>
    <p class="text-body-secondary">Current new, in-progress, and on-hold requests, sourced from the reporting view.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    else if (report is null)
    {
        <p class="text-body-secondary">Loading open requests…</p>
    }
    else if (report.Items.Count == 0)
    {
        <div class="alert alert-light border" role="status">There are no open requests.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <caption class="visually-hidden">Open requests from the MySQL reporting view.</caption>
                <thead><tr><th scope="col">Request</th><th scope="col">Status</th><th scope="col">Priority</th><th scope="col">Assignee</th><th scope="col">Age</th><th scope="col">Updated</th></tr></thead>
                <tbody>
                    @foreach (var summary in report.Items)
                    {
                        <tr>
                            <td><a href="requests/@summary.Id">@summary.RequestNumber</a><br /><span class="small text-body-secondary">@summary.Title</span></td>
                            <td>@ServiceRequestDisplay.Status(summary.Status)</td><td>@summary.Priority</td><td class="text-break">@DisplayUser(summary.AssigneeId)</td>
                            <td>@FormatAge(summary.Age)</td><td>@summary.UpdatedAtUtc.LocalDateTime.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex align-items-center justify-content-between" aria-label="Open request summary pages">
            <button class="btn btn-outline-secondary" type="button" @onclick="PreviousPageAsync" disabled="@(report.Page <= 1)">Previous</button>
            <span>Page @report.Page · @report.TotalCount total requests</span>
            <button class="btn btn-outline-secondary" type="button" @onclick="NextPageAsync" disabled="@(report.Page * report.PageSize >= report.TotalCount)">Next</button>
        </nav>
    }
</div>

@code {
    private PagedResult<OpenRequestSummaryDto>? report;
    private IReadOnlyDictionary<string, string> userDisplayNames = new Dictionary<string, string>();
    private string? errorMessage;
    private int currentPage = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var actor = RequestActorClaimsMapper.Create(principal);
        var result = await RequestService.GetOpenRequestSummariesAsync(actor, new OpenRequestSummaryQuery(currentPage), CancellationToken.None);
        if (result.Succeeded)
        {
            report = result.Value;
            var userIds = report!.Items
                .SelectMany(summary => new[] { summary.RequesterId, summary.AssigneeId })
                .OfType<string>()
                .Distinct(StringComparer.Ordinal)
                .ToArray();
            userDisplayNames = (await UserDirectory.GetByIdsAsync(userIds, CancellationToken.None))
                .ToDictionary(user => user.Id, user => user.DisplayName, StringComparer.Ordinal);
        }
        else errorMessage = "The open-request summary is unavailable.";
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (report is null || report.Page * report.PageSize >= report.TotalCount) return;
        currentPage++;
        await LoadAsync();
    }

    private string DisplayUser(string? userId) => userId is null
        ? "Unassigned"
        : userDisplayNames.GetValueOrDefault(userId, userId);

    private static string FormatAge(TimeSpan age) => age.TotalDays >= 1 ? $"{(int)age.TotalDays}d {age.Hours}h" : age.TotalHours >= 1 ? $"{(int)age.TotalHours}h {age.Minutes}m" : $"{Math.Max(0, (int)age.TotalMinutes)}m";
}
